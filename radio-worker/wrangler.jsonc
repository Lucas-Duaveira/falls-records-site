{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "falls-radio-host",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "vars": {
    "ALLOWED_ORIGIN": "https://lucas-duaveira.github.io"
  },
  "ratelimits": [
    {
      "name": "RADIO_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
