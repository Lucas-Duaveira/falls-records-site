const releasesForDisplay = [...releases].sort(
  (releaseA, releaseB) =>
    (releaseA.popularityRank ?? Number.POSITIVE_INFINITY) -
    (releaseB.popularityRank ?? Number.POSITIVE_INFINITY),
);

const artists = [
  {
    name: "Rise Rise, Forks",
    bio: "Banda independente da Falls Records. Este espaço reúne seus canais oficiais e músicas; a apresentação será atualizada com a descrição aprovada pela banda.",
    displayOrder: 1,
    links: [
      { label: "Linktree oficial", href: "https://linktr.ee/RiseForksBand" },
      { label: "Instagram", href: "https://www.instagram.com/riseforksband/" },
      { label: "TikTok", href: "https://www.tiktok.com/@rise.rise.forks" },
      { label: "Bandcamp", href: "https://riseriseforks.bandcamp.com/track/just-a-vapor" },
    ],
  },
  {
    name: "Rebecca Silveiras",
    bio: "Rebecca Silveiras é cantora e compositora da Falls Records. Conheça seus lançamentos e acompanhe seus canais oficiais.",
    displayOrder: 2,
    links: [
      { label: "Spotify", href: "https://open.spotify.com/artist/2L7ARWW5u2UJArBYJNAt3Z" },
      { label: "Instagram", href: "https://www.instagram.com/wowbk/" },
      { label: "Facebook", href: "https://www.facebook.com/wowbecca" },
      { label: "YouTube — Hurt Only", href: "https://www.youtube.com/watch?v=HFKa7-pvGgg" },
    ],
  },
  {
    name: "Duaveira",
    bio: "Duaveira é um projeto musical independente ligado à Falls Records. Este espaço reúne seus lançamentos e canais oficiais; a apresentação será atualizada com a visão do artista.",
    displayOrder: 3,
    links: [
      { label: "Spotify", href: "https://open.spotify.com/artist/2N7H6GiXTxRKq7uTXrzQvO" },
      { label: "Instagram", href: "https://www.instagram.com/duavessu/" },
      { label: "YouTube — Soft Sparks", href: "https://www.youtube.com/watch?v=fCwj8bCMbmg" },
    ],
  },
];

const artistsByDisplayOrder = [...artists].sort(
  (artistA, artistB) => artistA.displayOrder - artistB.displayOrder,
);

const updates = [
  { label: "EM BREVE", text: "Estamos reunindo novidades e informações oficiais dos projetos da gravadora." },
];
---

<BaseLayout
  title="Falls Records — Música independente"
  description="Conheça a Falls Records, seus artistas, lançamentos e projetos de música independente."
>
  <div class="site-shell" id="inicio">
    <div class="topbar">
      <p class="topbar-signature">FALLS RECORDS <span>•</span> MÚSICA INDEPENDENTE <span>•</span> BRASIL</p>
      <div class="topbar-right">
        <span class="welcome-label">BEM-VINDO À FALLS</span>
        <span class="topbar-status">CANAIS OFICIAIS EM PREPARAÇÃO</span>
      </div>
    </div>

    <header class="masthead">
      <a class="brand" href="#inicio" aria-label="Falls Records, início">
        <span class="brand-name">FALLS</span>
        <span class="brand-records">RECORDS</span>
        <span class="brand-tagline">MÚSICA INDEPENDENTE <span>/</span> FALLS RECORDS</span>
      </a>

      <div class="masthead-note" aria-label="Suporte à música independente">
        <span>SUPORTE À</span>
        <span>MÚSICA INDEPENDENTE</span>
        <i aria-hidden="true"></i>
        <small>ARTISTAS <b>•</b> LANÇAMENTOS <b>•</b> RÁDIO</small>
      </div>

      <div class="masthead-waterfall" aria-hidden="true"></div>

      <form class="mailing-list">
        <label class="mailing-title" for="mailing-email">LISTA DE NOVIDADES / EM BREVE</label>
        <div class="mailing-controls">
          <input id="mailing-email" name="email" type="email" autocomplete="email" placeholder="inscrições em breve" disabled />
          <button type="button" disabled>EM BREVE</button>
        </div>
        <p class="mailing-note">A lista será ativada quando o serviço de inscrição estiver conectado.</p>
      </form>
    </header>

    <nav class="main-nav" aria-label="Navegação principal">
      <a class="is-active" href="#inicio" aria-current="page">Início</a>
      <a href="#artistas">Artistas</a>
      <a href="#lancamentos">Lançamentos</a>
      <a href="#radio">Rádio</a>
      <a href="#novidades">Novidades</a>
      <a href="#sobre">Sobre</a>
      <a href="#contato">Contato</a>
      <span class="nav-signature">FALLS RECORDS / SOM EM MOVIMENTO</span>
    </nav>

    <main id="conteudo" class="content-grid">
      <section class="feature-panel panel" aria-labelledby="feature-title">
        <div class="feature-copy">
          <p class="eyebrow">LANÇAMENTO EM DESTAQUE <span>/</span> CATÁLOGO FALLS</p>
          <h1 id="feature-title">SOM EM<br />MOVIMENTO.</h1>
          <p class="feature-description">Artistas e lançamentos independentes<br class="desktop-break" /> com identidade própria.</p>
          <div class="feature-actions">
            <a class="button button-primary" href="#lancamentos">EXPLORAR LANÇAMENTOS <span aria-hidden="true">↗</span></a>
            <a class="button button-secondary" href="#artistas">VER ARTISTAS</a>
          </div>
          <span class="recording-mark"><i></i> REC</span>
        </div>

        <div class="cover-card" role="img" aria-label="Arte provisória de lançamento da Falls Records">
          <div class="cover-art" aria-hidden="true">
            <span class="cover-code">FR / ARTE EM DEFINIÇÃO</span>
            <span class="cover-disc"></span>
            <span class="cover-river cover-river-one"></span>
            <span class="cover-river cover-river-two"></span>
            <span class="cover-wordmark">FALLS</span>
            <span class="cover-records">RECORDS <b>•</b> MÚSICA INDEPENDENTE</span>
          </div>
        </div>
      </section>

      <aside class="radio-panel panel" id="radio" aria-labelledby="radio-title">
        <div class="panel-heading radio-heading">
          <h2 id="radio-title">RÁDIO FALLS</h2>
          <span class="status-badge">EM BREVE</span>
        </div>
        <div class="radio-visual" aria-hidden="true">
          <span class="radio-ring radio-ring-outer"></span>
          <span class="radio-ring radio-ring-middle"></span>
          <span class="radio-ring radio-ring-inner"></span>
          <span class="radio-monogram">FR</span>
          <i class="radio-dot"></i>
        </div>
        <p class="radio-selection">SELEÇÃO DE ARTISTAS PARCEIROS</p>
        <p class="radio-note">Formato da programação em definição</p>
        <button class="radio-button" type="button" disabled>
          <span aria-hidden="true">▶</span> OUVIR QUANDO DISPONÍVEL
        </button>
      </aside>

      <section class="releases-panel panel" id="lancamentos" aria-labelledby="releases-title">
        <div class="panel-heading">
          <h2 id="releases-title">ÚLTIMOS LANÇAMENTOS</h2>
          <span class="panel-status">CATÁLOGO SPOTIFY</span>
        </div>
        <div class="release-list">
          {releasesForDisplay.map((release) => (
            <article class="release-row" data-popularity-rank={release.popularityRank}>
              <div
                class="release-art"
                role="img"
                aria-label={`Arte de ${release.title} em preparação`}
              >
                <span>FR</span>
              </div>
              <div class="release-info">
                <h3>{release.title}</h3>
                <p>
                  {release.artist ?? "Duaveira"} <span>•</span> {release.kind}
                  {release.year && ` / ${release.year}`}
                </p>
                <div class="release-links">
                  {release.spotify && (
                    <a href={release.spotify} target="_blank" rel="noopener noreferrer">SPOTIFY</a>
                  )}
                  {release.youtube && (
                    <a href={release.youtube} target="_blank" rel="noopener noreferrer">YOUTUBE</a>
                  )}
                  {release.bandcamp && (
                    <a href={release.bandcamp} target="_blank" rel="noopener noreferrer">BANDCAMP</a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="artists-panel panel" id="artistas" aria-labelledby="artists-title">
        <div class="panel-heading">
          <h2 id="artists-title">ARTISTAS</h2>
          <span class="panel-status">BIOGRAFIA RASCUNHO</span>
        </div>
        <div class="artist-profiles">
          {artistsByDisplayOrder.map((artist) => (
            <article class="artist-profile">
              <div class="artist-profile-art" role="img" aria-label={`Imagem de ${artist.name} a adicionar`}>
                <span>{artist.name}</span>
              </div>
              <div class="artist-profile-copy">
                <h3>{artist.name}</h3>
                <p>{artist.bio}</p>
                <nav class="artist-links" aria-label={`Canais oficiais de ${artist.name}`}>
                  {artist.links.map((link) => (
                    <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
                  ))}
                </nav>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="news-panel panel" id="novidades" aria-labelledby="news-title">
        <div class="panel-heading">
          <h2 id="news-title">NOVIDADES &amp; ATUALIZAÇÕES</h2>
          <span class="panel-status">ATUALIZAÇÕES EM BREVE</span>
        </div>
        <div class="news-list">
          {updates.map((update) => (
            <article class="news-item">
              <span class="news-label">{update.label}</span>
              <p>{update.text}</p>
            </article>
          ))}
        </div>
      </section>

    </main>

    <footer class="site-footer" id="contato">
      <div class="footer-brand">
        <span>FALLS RECORDS</span>
        <small>CANAIS OFICIAIS EM BREVE</small>
      </div>
      <div class="footer-links">ARTISTAS <span>•</span> LANÇAMENTOS <span>•</span> RÁDIO</div>
      <div class="footer-site">
        <span>SITE OFICIAL / FALLS RECORDS</span>
        <small>© <span data-current-year>2026</span> FALLS RECORDS</small>
      </div>
      <p class="footer-tagline" id="sobre">FEITO PARA OUVIR COM ATENÇÃO.</p>
    </footer>

    <div class="bottom-signature" aria-hidden="true">★ <span>FALLS RECORDS — MÚSICA INDEPENDENTE</span> ★</div>
  </div>
</BaseLayout>

<script>
  const releaseList = document.querySelector(".release-list");

  if (releaseList) {
    const rows = Array.from(releaseList.querySelectorAll(".release-row"));
    const featuredRows = rows
      .filter((row) => row.hasAttribute("data-popularity-rank"))
      .sort(
        (rowA, rowB) =>
          Number(rowA.getAttribute("data-popularity-rank")) -
          Number(rowB.getAttribute("data-popularity-rank")),
      );
    const remainingRows = rows.filter(
      (row) => !row.hasAttribute("data-popularity-rank"),
    );

    for (let index = remainingRows.length - 1; index > 0; index -= 1) {
      const randomIndex = Math.floor(Math.random() * (index + 1));
      [remainingRows[index], remainingRows[randomIndex]] = [
        remainingRows[randomIndex],
        remainingRows[index],
      ];
    }

    releaseList.append(...featuredRows, ...remainingRows);
  }
</script>
