    year: "2025",
    kind: "Single",
    spotify: "https://open.spotify.com/album/7pIiz5EGyYp871KzUZpHv2",
  },
  {
    title: "Birdcage (Cover)",
    year: "2024",
    kind: "Single",
    spotify: "https://open.spotify.com/album/2P1exbrkr0QoeAqIcs6Hnh",
  },
  {
    title: "Sorriso ao Sono (Cover)",
    year: "2023",
    kind: "Single",
    spotify: "https://open.spotify.com/album/1xDprVm16tNVvoaqsui6aj",
  },
  {
