    displayOrder: 2,
    links: [
      { label: "Spotify", href: "https://open.spotify.com/artist/2L7ARWW5u2UJArBYJNAt3Z" },
      { label: "Apple Music", href: "https://music.apple.com/br/artist/rebecca-silveiras/1537283501" },
      { label: "Instagram", href: "https://www.instagram.com/wowbk/" },
      { label: "Facebook", href: "https://www.facebook.com/wowbecca" },
      { label: "YouTube — Hurt Only", href: "https://www.youtube.com/watch?v=HFKa7-pvGgg" },
    ],
