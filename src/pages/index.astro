    popularityRank: 3,
    year: "2025",
    kind: "Single",
    spotify: "https://open.spotify.com/album/72mRlOMgCryE3xO1BoCMDu",
    youtube: "https://www.youtube.com/watch?v=fCwj8bCMbmg",
  },
  {
    title: "mY piZZA (lame version)",
    year: "2025",
    kind: "Single",
    spotify: "https://open.spotify.com/album/7pIiz5EGyYp871KzUZpHv2",
  },
  {
    title: "Birdcage (Cover)",
    year: "2024",
    kind: "Single",
    spotify: "https://open.spotify.com/album/2P1exbrkr0QoeAqIcs6Hnh",
  },
  {
    title: "Sorriso ao Sono (Cover)",
    year: "2023",
    kind: "Single",
    spotify: "https://open.spotify.com/album/1xDprVm16tNVvoaqsui6aj",
  },
  {
    title: "Arms (Cover)",
    year: "2023",
    kind: "Single",
    spotify: "https://open.spotify.com/album/6bXIQVLXYH9b65L86cbgoq",
  },
  {
    title: "Well...",
    year: "2021",
    kind: "Single",
    spotify: "https://open.spotify.com/album/1ojj8YPFeB2TJjhGVZt6LP",
  },
  {
    title: "Say Goodbye Again",
    popularityRank: 2,
    year: "2025",
    kind: "Single",
    artist: "Rebecca Silveiras",
    spotify: "https://open.spotify.com/album/61UhKRBOc0dGScNURUdkJR",
  },
  {
    title: "Haunt You (cover)",
    year: "2024",
    kind: "Single",
    artist: "Rebecca Silveiras",
    spotify: "https://open.spotify.com/album/09AJX44DwC6ffPW3CxtxZp",
  },
  {
    title: "Lighthouse (Grampa House Version)",
    year: "2023",
    kind: "Single",
    artist: "Rebecca Silveiras",
    spotify: "https://open.spotify.com/album/41caG73VuxdLvhNDUSxUUp",
  },
  {
    title: "Hurt Only",
    year: "2021",
    kind: "Single",
    artist: "Rebecca Silveiras",
    spotify: "https://open.spotify.com/album/13ri8gxJRPS5ItcsEu3kh5",
    youtube: "https://www.youtube.com/watch?v=HFKa7-pvGgg",
  },
  {
    title: "Daquela Música, Vol. 1",
    year: "2020",
    kind: "Single",
    artist: "Rebecca Silveiras",
    spotify: "https://open.spotify.com/album/6seAUmv7lL3Y9hAkiQY9Xk",
  },
  {
    title: "You should care less",
    popularityRank: 1,
    year: "",
    kind: "Single",
    artist: "Rise Rise, Forks",
    spotify: "https://open.spotify.com/track/2TypVYOYq4pCHGeDAgohEc",
    youtube: "https://youtu.be/_dBPnNc7LNU",
  },
  {
    title: "Just a Vapor",
    year: "",
    kind: "Faixa",
    artist: "Rise Rise, Forks",
    bandcamp: "https://riseriseforks.bandcamp.com/track/just-a-vapor",
  },
];

const releasesForDisplay = [...releases].sort(
  (releaseA, releaseB) =>
    (releaseA.popularityRank ?? Number.POSITIVE_INFINITY) -
    (releaseB.popularityRank ?? Number.POSITIVE_INFINITY),
);

const artists = [
  {
    name: "Rise Rise, Forks",
    bio: "Banda independente da Falls Records. Este espaço reúne seus canais oficiais e músicas; a apresentação será atualizada com a descrição aprovada pela banda.",
    displayOrder: 1,
    links: [
      { label: "Linktree oficial", href: "https://linktr.ee/RiseForksBand" },
      { label: "Instagram", href: "https://www.instagram.com/riseforksband/" },
      { label: "TikTok", href: "https://www.tiktok.com/@rise.rise.forks" },
      { label: "Bandcamp", href: "https://riseriseforks.bandcamp.com/track/just-a-vapor" },
    ],
  },
  {
    name: "Rebecca Silveiras",
    bio: "Rebecca Silveiras é cantora e compositora da Falls Records. Conheça seus lançamentos e acompanhe seus canais oficiais.",
    displayOrder: 2,
    links: [
      { label: "Spotify", href: "https://open.spotify.com/artist/2L7ARWW5u2UJArBYJNAt3Z" },
      { label: "Instagram", href: "https://www.instagram.com/wowbk/" },
      { label: "Facebook", href: "https://www.facebook.com/wowbecca" },
      { label: "YouTube — Hurt Only", href: "https://www.youtube.com/watch?v=HFKa7-pvGgg" },
    ],
  },
  {
    name: "Duaveira",
    bio: "Duaveira é um projeto musical independente ligado à Falls Records. Este espaço reúne seus lançamentos e canais oficiais; a apresentação será atualizada com a visão do artista.",
    displayOrder: 3,
    links: [
      { label: "Spotify", href: "https://open.spotify.com/artist/2N7H6GiXTxRKq7uTXrzQvO" },
      { label: "Instagram", href: "https://www.instagram.com/duavessu/" },
      { label: "YouTube — Soft Sparks", href: "https://www.youtube.com/watch?v=fCwj8bCMbmg" },
    ],
  },
];

const artistsByDisplayOrder = [...artists].sort(
  (artistA, artistB) => artistA.displayOrder - artistB.displayOrder,
);

const updates = [
  { label: "EM BREVE", text: "Estamos reunindo novidades e informações oficiais dos projetos da gravadora." },
];

---

<BaseLayout
  title="Falls Records — Música independente"
  description="Conheça a Falls Records, seus artistas, lançamentos e projetos de música independente."
>
  <div class="site-shell" id="inicio">
    <div class="topbar">
      <p class="topbar-signature">FALLS RECORDS <span>•</span> MÚSICA INDEPENDENTE <span>•</span> BRASIL</p>
      <div class="topbar-right">
        <span class="welcome-label">BEM-VINDO À FALLS</span>
        <span class="topbar-status">CANAIS OFICIAIS EM PREPARAÇÃO</span>
      </div>
    </div>

    <header class="masthead">
      <a class="brand" href="#inicio" aria-label="Falls Records, início">
        <img
          class="brand-logo"
          src={`${import.meta.env.BASE_URL}/assets/logos/falls-records-logo.png`}
          alt=""
          width="1800"
          height="897"
        />
        <span class="brand-tagline">MÚSICA INDEPENDENTE <span>/</span> FALLS RECORDS</span>
      </a>

      <div class="masthead-note" aria-label="Suporte à música independente">
        <span>SUPORTE À</span>
        <span>MÚSICA INDEPENDENTE</span>
        <i aria-hidden="true"></i>
        <small>ARTISTAS <b>•</b> LANÇAMENTOS <b>•</b> RÁDIO</small>
      </div>

      <div class="masthead-waterfall" aria-hidden="true"></div>

      <form class="mailing-list">
        <label class="mailing-title" for="mailing-email">LISTA DE NOVIDADES / EM BREVE</label>
        <div class="mailing-controls">
          <input id="mailing-email" name="email" type="email" autocomplete="email" placeholder="inscrições em breve" disabled />
          <button type="button" disabled>EM BREVE</button>
        </div>
        <p class="mailing-note">A lista será ativada quando o serviço de inscrição estiver conectado.</p>
      </form>
    </header>

    <section class="artist-carousel" aria-label="Artistas da Falls Records ao vivo">
      <figure class="artist-carousel-slide">
        <img
          src={`${import.meta.env.BASE_URL}/assets/images/carousel/rise-rise-forks-live.jpg`}
          alt="Rise Rise, Forks se apresentando ao vivo"
          width="2048"
          height="1365"
          fetchpriority="high"
        />
        <figcaption>RISE RISE, FORKS <span>•</span> AO VIVO</figcaption>
      </figure>
    </section>

    <nav class="main-nav" aria-label="Navegação principal">
      <a class="is-active" href="#inicio" aria-current="page">Início</a>
      <a href="#artistas">Artistas</a>
      <a href="#lancamentos">Lançamentos</a>
      <a href="#radio">Rádio</a>
      <a href="#novidades">Novidades</a>
      <a href="#sobre">Sobre</a>
      <a href="#contato">Contato</a>
      <span class="nav-signature">FALLS RECORDS / SOM EM MOVIMENTO</span>
    </nav>

    <main id="conteudo" class="content-grid">
      <section class="feature-panel panel" aria-labelledby="feature-title">
        <div class="feature-copy">
          <p class="eyebrow">LANÇAMENTO EM DESTAQUE <span>/</span> CATÁLOGO FALLS</p>
          <h1 id="feature-title">SOM EM<br />MOVIMENTO.</h1>
          <p class="feature-description">Artistas e lançamentos independentes<br class="desktop-break" /> com identidade própria.</p>
          <div class="feature-actions">
            <a class="button button-primary" href="#lancamentos">EXPLORAR LANÇAMENTOS <span aria-hidden="true">↗</span></a>
            <a class="button button-secondary" href="#artistas">VER ARTISTAS</a>
          </div>
          <span class="recording-mark"><i></i> REC</span>
        </div>

        <div class="cover-card" role="img" aria-label="Arte provisória de lançamento da Falls Records">
          <div class="cover-art" aria-hidden="true">
            <span class="cover-code">FR / ARTE EM DEFINIÇÃO</span>
            <span class="cover-disc"></span>
            <span class="cover-river cover-river-one"></span>
            <span class="cover-river cover-river-two"></span>
            <span class="cover-wordmark">FALLS</span>
            <span class="cover-records">RECORDS <b>•</b> MÚSICA INDEPENDENTE</span>
          </div>
        </div>
      </section>

      <aside class="radio-panel panel" id="radio" aria-labelledby="radio-title">
        <div class="panel-heading radio-heading">
          <h2 id="radio-title">RÁDIO FALLS</h2>
          <span class="panel-status">PLAYLIST + LOCUÇÃO</span>
        </div>
        <div
          class="radio-cover"
          role="img"
          aria-label="Capa provisória da Rádio Falls Records. Arte final em breve."
        >
          <span class="radio-cover-code">FR / RADIO SESSION</span>
          <span class="radio-cover-disc"></span>
          <span class="radio-cover-wave radio-cover-wave-one"></span>
          <span class="radio-cover-wave radio-cover-wave-two"></span>
          <span class="radio-cover-wordmark">FALLS</span>
          <span class="radio-cover-title">RÁDIO RECORDS</span>
          <span class="radio-cover-caption">ARTISTAS <b>•</b> LANÇAMENTOS <b>•</b> SOM EM MOVIMENTO</span>
        </div>
        <div class="radio-announcer" data-radio-announcer>
          <p class="radio-selection">APRESENTAÇÃO FALLS</p>
          <p class="radio-announcer-status" data-announcer-status aria-live="polite">
            Ouça as boas-vindas e depois aperte play na playlist.
          </p>
          <button class="radio-announcer-button" type="button" data-announcer-toggle>
            <span aria-hidden="true">▶</span> OUVIR BOAS-VINDAS
          </button>
        </div>
        <p class="radio-playlist-label">PLAYLIST OFICIAL <span>•</span> SPOTIFY</p>
        <div class="radio-player">
          <iframe
            title="Playlist Falls Records — Rádio no Spotify"
            src="https://open.spotify.com/embed/playlist/0VwEgmhmIaVJuqMfkfOReq?utm_source=generator&theme=0"
            width="100%"
            height="152"
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
      </aside>

      <section class="releases-panel panel" id="lancamentos" aria-labelledby="releases-title">
        <div class="panel-heading">
          <h2 id="releases-title">ÚLTIMOS LANÇAMENTOS</h2>
          <span class="panel-status">CATÁLOGO SPOTIFY</span>
        </div>
        <div class="release-list">
          {releasesForDisplay.map((release) => (
            <article
              class="release-row"
              data-release-title={release.title}
              data-release-artist={release.artist ?? "Duaveira"}
              data-popularity-rank={release.popularityRank}
            >
              <div
                class="release-art"
                role="img"
                aria-label={`Arte de ${release.title} em preparação`}
              >
                <img class="release-art-image" alt="" loading="lazy" decoding="async" hidden />
                <span>FR</span>
              </div>
              <div class="release-info">
                <h3>{release.title}</h3>
                <p>
                  {release.artist ?? "Duaveira"} <span>•</span> {release.kind}
                  {release.year && ` / ${release.year}`}
                </p>
                <div class="release-links">
                  {release.spotify && (
                    <a href={release.spotify} target="_blank" rel="noopener noreferrer">SPOTIFY</a>
                  )}
                  {release.youtube && (
                    <a href={release.youtube} target="_blank" rel="noopener noreferrer">YOUTUBE</a>
                  )}
                  {release.bandcamp && (
                    <a href={release.bandcamp} target="_blank" rel="noopener noreferrer">BANDCAMP</a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="artists-panel panel" id="artistas" aria-labelledby="artists-title">
        <div class="panel-heading">
          <h2 id="artists-title">ARTISTAS</h2>
          <span class="panel-status">BIOGRAFIA RASCUNHO</span>
        </div>
        <div class="artist-profiles">
          {artistsByDisplayOrder.map((artist) => (
            <article class="artist-profile">
              <div class="artist-profile-art" role="img" aria-label={`Imagem de ${artist.name} a adicionar`}>
                <span>{artist.name}</span>
              </div>
              <div class="artist-profile-copy">
                <h3>{artist.name}</h3>
                <p>{artist.bio}</p>
                <nav class="artist-links" aria-label={`Canais oficiais de ${artist.name}`}>
                  {artist.links.map((link) => (
                    <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
                  ))}
                </nav>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="news-panel panel" id="novidades" aria-labelledby="news-title">
        <div class="panel-heading">
          <h2 id="news-title">NOVIDADES &amp; ATUALIZAÇÕES</h2>
          <span class="panel-status">ATUALIZAÇÕES EM BREVE</span>
        </div>
        <div class="news-list">
          {updates.map((update) => (
            <article class="news-item">
              <span class="news-label">{update.label}</span>
              <p>{update.text}</p>
            </article>
          ))}
        </div>
      </section>

    </main>

    <footer class="site-footer" id="contato">
      <div class="footer-brand">
        <span>FALLS RECORDS</span>
        <small>CANAIS OFICIAIS EM BREVE</small>
      </div>
      <div class="footer-links">ARTISTAS <span>•</span> LANÇAMENTOS <span>•</span> RÁDIO</div>
      <div class="footer-site">
        <span>SITE OFICIAL / FALLS RECORDS</span>
        <small>© <span data-current-year>2026</span> FALLS RECORDS</small>
      </div>
      <p class="footer-tagline" id="sobre">FEITO PARA OUVIR COM ATENÇÃO.</p>
    </footer>

    <div class="bottom-signature" aria-hidden="true">★ <span>FALLS RECORDS — MÚSICA INDEPENDENTE</span> ★</div>
  </div>
</BaseLayout>

<script>
  const releaseList = document.querySelector(".release-list");

  if (releaseList) {
    const rows = Array.from(releaseList.querySelectorAll(".release-row"));
    const featuredRows = rows
      .filter((row) => row.hasAttribute("data-popularity-rank"))
      .sort(
        (rowA, rowB) =>
          Number(rowA.getAttribute("data-popularity-rank")) -
          Number(rowB.getAttribute("data-popularity-rank")),
      );
    const remainingRows = rows.filter(
      (row) => !row.hasAttribute("data-popularity-rank"),
    );

    for (let index = remainingRows.length - 1; index > 0; index -= 1) {
      const randomIndex = Math.floor(Math.random() * (index + 1));
      [remainingRows[index], remainingRows[randomIndex]] = [
        remainingRows[randomIndex],
        remainingRows[index],
      ];
    }

    releaseList.append(...featuredRows, ...remainingRows);

    const normalizeCatalogName = (value) =>
      value
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .replace(/[^a-z0-9]/g, "");

    const rowsByArtist = new Map();
    for (const row of rows) {
      const artist = row.dataset.releaseArtist;
      if (!artist) continue;

      const artistRows = rowsByArtist.get(artist) ?? [];
      artistRows.push(row);
      rowsByArtist.set(artist, artistRows);
    }

    const loadArtistArtwork = async (artist, artistRows) => {
      const searchUrl = new URL("https://itunes.apple.com/search");
      searchUrl.searchParams.set("term", artist);
      searchUrl.searchParams.set("entity", "album");
      searchUrl.searchParams.set("limit", "200");

      try {
        const response = await fetch(searchUrl);
        if (!response.ok) {
          throw new Error(`Apple Music respondeu com status ${response.status}.`);
        }

        const catalog = await response.json();
        if (!Array.isArray(catalog.results)) {
          throw new Error("A resposta do catálogo Apple Music é inválida.");
        }

        for (const row of artistRows) {
          const title = normalizeCatalogName(row.dataset.releaseTitle ?? "");
          const match = catalog.results.find(
            (release) =>
              normalizeCatalogName(release.artistName ?? "") ===
                normalizeCatalogName(artist) &&
              normalizeCatalogName(release.collectionName ?? "").includes(title),
          );
          const image = row.querySelector(".release-art-image");
          const artwork = row.querySelector(".release-art");

          if (!match?.artworkUrl100 || !(image instanceof HTMLImageElement)) {
            artwork?.setAttribute(
              "aria-label",
              `Capa oficial de ${row.dataset.releaseTitle} não encontrada; monograma Falls exibido`,
            );
            console.warn(`Capa não encontrada no Apple Music: ${row.dataset.releaseTitle}`);
            continue;
          }

          const fallback = artwork?.querySelector("span");
          image.addEventListener(
            "load",
            () => {
              image.hidden = false;
              fallback?.setAttribute("hidden", "");
              artwork?.classList.add("has-image");
              artwork?.setAttribute(
                "aria-label",
                `Capa de ${row.dataset.releaseTitle} por ${artist}`,
              );
            },
            { once: true },
          );
          image.addEventListener(
            "error",
            () => {
              artwork?.setAttribute(
                "aria-label",
                `Capa de ${row.dataset.releaseTitle} indisponível; monograma Falls exibido`,
              );
              console.warn(`Não foi possível carregar a capa: ${row.dataset.releaseTitle}`);
            },
            { once: true },
          );
          image.src = match.artworkUrl100.replace(
            /\/\d+x\d+bb\.(jpg|png)$/i,
            "/600x600bb.$1",
          );
        }
      } catch (error) {
        for (const row of artistRows) {
          row.querySelector(".release-art")?.setAttribute(
            "aria-label",
            `Busca da capa de ${row.dataset.releaseTitle} indisponível; monograma Falls exibido`,
          );
        }
        console.error(`Não foi possível buscar capas para ${artist}.`, error);
      }
    };

    void Promise.all(
      [...rowsByArtist].map(([artist, artistRows]) =>
        loadArtistArtwork(artist, artistRows),
      ),
    );
  }
</script>
