const updates = [
  { label: "EM BREVE", text: "Estamos reunindo novidades e informações oficiais dos projetos da gravadora." },
];

---

<BaseLayout
  title="Falls Records — Música independente"
  description="Conheça a Falls Records, seus artistas, lançamentos e projetos de música independente."
>
  <div class="site-shell" id="inicio">
    <div class="topbar">
      <p class="topbar-signature">FALLS RECORDS <span>•</span> MÚSICA INDEPENDENTE <span>•</span> BRASIL</p>
      <div class="topbar-right">
        <span class="welcome-label">BEM-VINDO À FALLS</span>
        <span class="topbar-status">CANAIS OFICIAIS EM PREPARAÇÃO</span>
      </div>
    </div>

    <header class="masthead">
      <a class="brand" href="#inicio" aria-label="Falls Records, início">
        <img
          class="brand-logo"
          src={`${import.meta.env.BASE_URL}/assets/logos/falls-records-logo.webp`}
          alt=""
          width="720"
          height="359"
        />
        <span class="brand-tagline">MÚSICA INDEPENDENTE <span>/</span> FALLS RECORDS</span>
      </a>

      <div class="masthead-note" aria-label="Suporte à música independente">
        <span>SUPORTE À</span>
        <span>MÚSICA INDEPENDENTE</span>
        <i aria-hidden="true"></i>
        <small>ARTISTAS <b>•</b> LANÇAMENTOS <b>•</b> RÁDIO</small>
      </div>

      <div class="masthead-waterfall" aria-hidden="true"></div>

      <form class="mailing-list">
        <label class="mailing-title" for="mailing-email">LISTA DE NOVIDADES / EM BREVE</label>
        <div class="mailing-controls">
          <input id="mailing-email" name="email" type="email" autocomplete="email" placeholder="inscrições em breve" disabled />
          <button type="button" disabled>EM BREVE</button>
        </div>
        <p class="mailing-note">A lista será ativada quando o serviço de inscrição estiver conectado.</p>
      </form>
    </header>

    <section class="artist-carousel" aria-label="Artistas da Falls Records ao vivo">
      <figure class="artist-carousel-slide">
        <img
          src={`${import.meta.env.BASE_URL}/assets/images/carousel/rise-rise-forks-live.webp`}
          alt="Rise Rise, Forks se apresentando ao vivo"
          width="1600"
          height="1066"
          decoding="async"
          fetchpriority="high"
        />
        <figcaption>RISE RISE, FORKS <span>•</span> AO VIVO</figcaption>
      </figure>
    </section>

    <nav class="main-nav" aria-label="Navegação principal">
      <a class="is-active" href="#inicio" aria-current="page">Início</a>
      <a href="#artistas">Artistas</a>
      <a href="#lancamentos">Lançamentos</a>
      <a href="#radio">Rádio</a>
      <a href="#novidades">Novidades</a>
      <a href="#sobre">Sobre</a>
      <a href="#contato">Contato</a>
      <span class="nav-signature">FALLS RECORDS / SOM EM MOVIMENTO</span>
    </nav>

    <main id="conteudo" class="content-grid">
      <section class="feature-panel panel" aria-labelledby="feature-title">
        <div class="feature-copy">
          <p class="eyebrow">LANÇAMENTO EM DESTAQUE <span>/</span> CATÁLOGO FALLS</p>
          <h1 id="feature-title">SOM EM<br />MOVIMENTO.</h1>
          <p class="feature-description">Artistas e lançamentos independentes<br class="desktop-break" /> com identidade própria.</p>
          <div class="feature-actions">
            <a class="button button-primary" href="#lancamentos">EXPLORAR LANÇAMENTOS <span aria-hidden="true">↗</span></a>
            <a class="button button-secondary" href="#artistas">VER ARTISTAS</a>
          </div>
          <span class="recording-mark"><i></i> REC</span>
        </div>

        <div class="cover-card" role="img" aria-label="Arte provisória de lançamento da Falls Records">
          <div class="cover-art" aria-hidden="true">
            <span class="cover-code">FR / ARTE EM DEFINIÇÃO</span>
            <span class="cover-disc"></span>
            <span class="cover-river cover-river-one"></span>
            <span class="cover-river cover-river-two"></span>
            <span class="cover-wordmark">FALLS</span>
            <span class="cover-records">RECORDS <b>•</b> MÚSICA INDEPENDENTE</span>
          </div>
        </div>
      </section>

      <aside class="radio-panel panel" id="radio" aria-labelledby="radio-title">
        <div class="panel-heading radio-heading">
          <h2 id="radio-title">RÁDIO FALLS</h2>
          <span class="panel-status">PLAYLIST + LOCUÇÃO</span>
        </div>
        <div class="radio-cover">
          <img
            src={`${import.meta.env.BASE_URL}/assets/images/radio-falls.jpg`}
            alt="Logo da Falls Records em fundo azul na capa da Rádio Falls"
            width="480"
            height="484"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="radio-announcer" data-radio-announcer>
          <p class="radio-selection">APRESENTAÇÃO FALLS</p>
          <p class="radio-announcer-status" data-announcer-status aria-live="polite">
            Ouça as boas-vindas e depois aperte play na playlist.
          </p>
          <button class="radio-announcer-button" type="button" data-announcer-toggle>
            <span aria-hidden="true">▶</span> OUVIR BOAS-VINDAS
          </button>
        </div>
        <p class="radio-playlist-label">PLAYLIST OFICIAL <span>•</span> SPOTIFY</p>
        <div class="radio-player">
          <iframe
            title="Playlist Falls Records — Rádio no Spotify"
            src="https://open.spotify.com/embed/playlist/0VwEgmhmIaVJuqMfkfOReq?utm_source=generator&theme=0"
            width="100%"
            height="152"
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
      </aside>

      <section class="releases-panel panel" id="lancamentos" aria-labelledby="releases-title">
        <div class="panel-heading">
          <h2 id="releases-title">ÚLTIMOS LANÇAMENTOS</h2>
          <span class="panel-status">CATÁLOGO SPOTIFY</span>
        </div>
        <div class="release-list">
          {releasesForDisplay.map((release) => (
            <article
              class="release-row"
              data-release-title={release.title}
              data-release-artist={release.artist ?? "Duaveira"}
              data-release-artwork={release.artwork}
              data-release-artist-id={
                appleMusicArtistIds[release.artist ?? "Duaveira"] ??
                appleMusicArtistIds.Duaveira
              }
              data-popularity-rank={release.popularityRank}
            >
              <div
                class="release-art"
                role="img"
                aria-label={`Arte de ${release.title} em preparação`}
              >
                <img class="release-art-image" alt="" loading="lazy" decoding="async" />
                <span>FR</span>
              </div>
              <div class="release-info">
                <h3>{release.title}</h3>
                <p>
                  {release.artist ?? "Duaveira"} <span>•</span> {release.kind}
                  {release.year && ` / ${release.year}`}
                </p>
                <div class="release-links">
                  {release.spotify && (
                    <a href={release.spotify} target="_blank" rel="noopener noreferrer">SPOTIFY</a>
                  )}
                  {release.youtube && (
                    <a href={release.youtube} target="_blank" rel="noopener noreferrer">YOUTUBE</a>
                  )}
                  {release.bandcamp && (
                    <a href={release.bandcamp} target="_blank" rel="noopener noreferrer">BANDCAMP</a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="artists-panel panel" id="artistas" aria-labelledby="artists-title">
        <div class="panel-heading">
          <h2 id="artists-title">ARTISTAS</h2>
          <span class="panel-status">PERFIS E MÍDIAS OFICIAIS</span>
        </div>
        <div class="artist-profiles">
          {artistsByDisplayOrder.map((artist) => (
            <article class="artist-profile">
              <div
                class="artist-profile-art"
                role="img"
                aria-label={`Imagem oficial de ${artist.name}`}
              >
                <img
                  class="artist-profile-image"
                  src={artist.image}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <span>{artist.name}</span>
              </div>
              <div class="artist-profile-copy">
                <h3>{artist.name}</h3>
                <p>{artist.bio}</p>
                <nav class="artist-links" aria-label={`Canais oficiais de ${artist.name}`}>
                  {artist.links.map((link) => (
                    <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
                  ))}
                </nav>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="news-panel panel" id="novidades" aria-labelledby="news-title">
        <div class="panel-heading">
          <h2 id="news-title">NOVIDADES &amp; ATUALIZAÇÕES</h2>
          <span class="panel-status">ATUALIZAÇÕES EM BREVE</span>
        </div>
        <div class="news-list">
          {updates.map((update) => (
            <article class="news-item">
              <span class="news-label">{update.label}</span>
              <p>{update.text}</p>
            </article>
          ))}
        </div>
      </section>

    </main>

    <footer class="site-footer" id="contato">
      <div class="footer-brand">
        <span>FALLS RECORDS</span>
        <small>CANAIS OFICIAIS EM BREVE</small>
      </div>
      <div class="footer-links">ARTISTAS <span>•</span> LANÇAMENTOS <span>•</span> RÁDIO</div>
      <div class="footer-site">
        <span>SITE OFICIAL / FALLS RECORDS</span>
        <small>© <span data-current-year>2026</span> FALLS RECORDS</small>
      </div>
      <p class="footer-tagline" id="sobre">FEITO PARA OUVIR COM ATENÇÃO.</p>
    </footer>

    <div class="bottom-signature" aria-hidden="true">★ <span>FALLS RECORDS — MÚSICA INDEPENDENTE</span> ★</div>
  </div>
</BaseLayout>

<script>
  const releaseList = document.querySelector(".release-list");

  if (releaseList) {
    const rows = Array.from(releaseList.querySelectorAll(".release-row"));
    const featuredRows = rows
      .filter((row) => row.hasAttribute("data-popularity-rank"))
      .sort(
        (rowA, rowB) =>
          Number(rowA.getAttribute("data-popularity-rank")) -
          Number(rowB.getAttribute("data-popularity-rank")),
      );
    const remainingRows = rows.filter(
      (row) => !row.hasAttribute("data-popularity-rank"),
    );

    for (let index = remainingRows.length - 1; index > 0; index -= 1) {
      const randomIndex = Math.floor(Math.random() * (index + 1));
      [remainingRows[index], remainingRows[randomIndex]] = [
        remainingRows[randomIndex],
        remainingRows[index],
      ];
    }

    releaseList.append(...featuredRows, ...remainingRows);

    const normalizeCatalogName = (value) =>
      value
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .replace(/[^a-z0-9]/g, "");

    const rowsByArtist = new Map();
    for (const row of rows) {
      const artist = row.dataset.releaseArtist;
      const artistId = row.dataset.releaseArtistId;
      if (!artist || !artistId) continue;

      const artistRows = rowsByArtist.get(artistId) ?? [];
      artistRows.push(row);
      rowsByArtist.set(artistId, artistRows);
    }

    const showReleaseArtwork = (row, artworkUrl) => {
      const image = row.querySelector(".release-art-image");
      const artwork = row.querySelector(".release-art");
      const fallback = artwork?.querySelector("span");

      if (!(image instanceof HTMLImageElement)) return;

      image.addEventListener(
        "load",
        () => {
          image.classList.add("is-loaded");
          fallback?.setAttribute("hidden", "");
          artwork?.classList.add("has-image");
          artwork?.setAttribute(
            "aria-label",
            `Capa de ${row.dataset.releaseTitle} por ${row.dataset.releaseArtist}`,
          );
        },
        { once: true },
      );
      image.addEventListener(
        "error",
        () => {
          artwork?.setAttribute(
            "aria-label",
            `Capa de ${row.dataset.releaseTitle} indisponível; monograma Falls exibido`,
          );
          console.warn(`Não foi possível carregar a capa: ${row.dataset.releaseTitle}`);
        },
        { once: true },
      );
      image.src = artworkUrl.replace(/\/\d+x\d+bb\.(jpg|png)$/i, "/180x180bb.$1");
    };

    const loadArtistArtwork = async (artistId, artistRows) => {
      const catalogRows = artistRows.filter((row) => {
        const artworkUrl = row.dataset.releaseArtwork;
        if (artworkUrl) {
          showReleaseArtwork(row, artworkUrl);
          return false;
        }
        return true;
      });

      if (catalogRows.length === 0) return;

      const lookupUrl = new URL("https://itunes.apple.com/lookup");
      lookupUrl.searchParams.set("id", artistId);
      lookupUrl.searchParams.set("entity", "song");

      try {
        const response = await fetch(lookupUrl);
        if (!response.ok) {
          throw new Error(`Apple Music respondeu com status ${response.status}.`);
        }

        const catalog = await response.json();
        if (!Array.isArray(catalog.results)) {
          throw new Error("A resposta do catálogo Apple Music é inválida.");
        }

        for (const row of catalogRows) {
          const releaseTitle = row.dataset.releaseTitle ?? "";
          const titleVariants = [
            normalizeCatalogName(releaseTitle),
            normalizeCatalogName(releaseTitle.replace(/\s*[\[(].*?[\])]/g, "")),
          ].filter(Boolean);
          const match = catalog.results.find((release) => {
            if (release.kind !== "song") return false;
            const catalogTitle = normalizeCatalogName(
              release.trackName ?? release.trackCensoredName ?? "",
            );
            return titleVariants.some((title) => catalogTitle.includes(title));
          });
          const artwork = row.querySelector(".release-art");
          const artworkUrl = match?.artworkUrl100;

          if (!artworkUrl) {
            artwork?.setAttribute(
              "aria-label",
              `Capa oficial de ${releaseTitle} não encontrada no Apple Music; monograma Falls exibido`,
            );
            console.warn(`Capa não encontrada no Apple Music: ${releaseTitle}`);
            continue;
          }

          showReleaseArtwork(row, artworkUrl);
        }
      } catch (error) {
        for (const row of catalogRows) {
          row.querySelector(".release-art")?.setAttribute(
            "aria-label",
            `Busca da capa de ${row.dataset.releaseTitle} indisponível; monograma Falls exibido`,
          );
        }
        console.error(`Não foi possível buscar capas para o artista ${artistId}.`, error);
      }
    };

    void Promise.all(
      [...rowsByArtist].map(([artistId, artistRows]) =>
        loadArtistArtwork(artistId, artistRows),
      ),
    );
  }

  document.querySelectorAll(".artist-profile-image").forEach((image) => {
    if (!(image instanceof HTMLImageElement)) return;

    const artwork = image.closest(".artist-profile-art");
    const fallback = artwork?.querySelector("span");
    const markAsLoaded = () => {
      image.classList.add("is-loaded");
      fallback?.setAttribute("hidden", "");
    };

    image.addEventListener("load", markAsLoaded, { once: true });
    image.addEventListener(
      "error",
      () => {
        console.warn(`Não foi possível carregar a imagem de ${fallback?.textContent}.`);
      },
      { once: true },
    );

    if (image.complete && image.naturalWidth > 0) {
      markAsLoaded();
    }
  });
</script>
