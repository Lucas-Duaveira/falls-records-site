    image: "https://i.scdn.co/image/ab6761610000939b647ca065ae422eabaa763f75",
    displayOrder: 3,
    links: [
      { label: "Spotify", href: "https://open.spotify.com/artist/2N7H6GiXTxRKq7uTXrzQvO" },
      { label: "Apple Music", href: "https://music.apple.com/br/artist/duaveira/1537283448" },
      { label: "Instagram", href: "https://www.instagram.com/duavessu/" },
